<!DOCTYPE html>
<html>
<head>
    <title>Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">

<div class="bg-white p-8 rounded shadow-md w-[500px]">
    <h1 class="text-2xl font-bold mb-6 text-center">Panel de Administrador</h1>

    <% if (typeof mensaje !== "undefined") { %>
        <div class="mb-4 p-2 rounded bg-green-200 text-green-800">
            <%= mensaje %>
        </div>
    <% } %>

    <table class="w-full border">
        <thead>
            <tr class="bg-gray-200">
                <th class="p-2">ID</th>
                <th class="p-2">Email</th>
                <th class="p-2">Rol</th>
            </tr>
        </thead>
        <tbody>
            <% usuarios.forEach(user => { %>
                <tr class="text-center border-t">
                    <td class="p-2"><%= user.id %></td>
                    <td class="p-2"><%= user.email %></td>
                    <td class="p-2"><%= user.rol %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <form action="/auth/logout" method="POST" class="mt-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="w-full bg-red-500 text-white p-2 rounded hover:bg-red-600">
            Cerrar sesión
        </button>
    </form>
</div>

</body>
</html>