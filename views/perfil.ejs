<!DOCTYPE html>
<html>
<head>
    <title>Perfil</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center h-screen">

<div class="bg-white p-8 rounded shadow-md w-96">
    <h1 class="text-2xl font-bold mb-6 text-center">Perfil del usuario</h1>

    <% if (typeof mensaje !== "undefined") { %>
        <div class="mb-4 p-2 rounded <%= tipo === 'error' ? 'bg-red-200 text-red-800' : 'bg-green-200 text-green-800' %>">
            <%= mensaje %>
        </div>
    <% } %>

    <div class="mb-4">
        <p class="font-medium">ID: <span class="text-gray-700"><%= userId %></span></p>
        <p class="font-medium">Rol: <span class="text-gray-700"><%= role %></span></p>
    </div>
    

    <form action="/auth/logout" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="w-full bg-red-500 text-white p-2 rounded hover:bg-red-600 transition">Cerrar sesión</button>
    </form>
</div>

</body>
</html>